# Copy this file to .env and fill in your actual values

NODE_ENV=development
VNA_PORT=3333
VNA_DB_HOST=localhost
VNA_DB_PORT=5432
VNA_DB_USER=postgres
VNA_DB_PASSWORD=your_db_password_here
VNA_DB_DATABASE=ncc_dev
VNA_TOKEN_SECRET_KEY=your_jwt_secret_key_here
dirTemp=../../../src/commons/templates
SENDGRID_KEY=your_sendgrid_api_key_here
EMAIL_FROM=your_email@example.com

